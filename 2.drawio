        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n:系统上电;\n:执行setup();\n:初始化LED模块\\n(led.setup());\n:配置CAN总线\\n(CAN_BUS.setup());\nif (工作模式选择) then (同步模式)\n  :创建同步收发线程\\n(即时转发);\nelse (异步模式)\n  :创建异步接收线程;\n  :创建数据处理线程;\nendif\nfork\n  :启动LED状态线程;\nfork again\n  :启动CAN接收线程;\nfork again\n  :启动CAN发送线程;\nend fork\n:进入主循环;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-4">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="160" y="-368" width="439" height="660" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstate \&quot;正常模式\&quot; as Normal : 呼吸灯效果\\n低亮度渐变\nstate \&quot;CAN离线\&quot; as CanOutline : 快闪模式\nstate \&quot;设备离线\&quot; as DeviceOutline : 常亮模式\\n(高亮度)\nstate \&quot;其他异常\&quot; as Other : 双闪模式\n\n[*] --&gt; Normal\nNormal --&gt; CanOutline : 检测到\\n总线错误\nNormal --&gt; DeviceOutline : 外设\\n无响应\nNormal --&gt; Other : 未知\\n异常类型\n\nCanOutline --&gt; Normal : 总线\\n恢复\nDeviceOutline --&gt; Normal : 设备\\n重连\nOther --&gt; Normal : 异常\\n解除\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="640" y="-360" width="427" height="303" as="geometry" />
          </mxCell>
        </UserObject>
