            <mxGeometry x="-400" y="50" width="902.99" height="444" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstate \&quot;正常模式\&quot; as Normal : 呼吸灯效果\\n低亮度渐变\nstate \&quot;CAN离线\&quot; as CanOutline : 快闪模式\\n(周期500ms)\nstate \&quot;设备离线\&quot; as DeviceOutline : 常亮模式\\n(高亮度)\nstate \&quot;其他异常\&quot; as Other : 双闪模式\\n(短间隔200ms + 长间隔800ms)\n\n[*] --&gt; Normal\nNormal --&gt; CanOutline : 检测到\\n总线错误\nNormal --&gt; DeviceOutline : 外设\\n无响应\nNormal --&gt; Other : 未知\\n异常类型\n\nCanOutline --&gt; Normal : 总线\\n恢复\nDeviceOutline --&gt; Normal : 设备\\n重连\nOther --&gt; Normal : 异常\\n解除\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-2">
