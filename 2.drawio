        <mxCell id="W11vk77ngovL1KlK19xO-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="VmwB85Ww3C7b3GIS1e9m-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-388.5050000000001" y="406" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ncomponent \&quot;CAN模块\&quot; as CAN {\n    component \&quot;CAN_BUS(6,7)\&quot; as CAN_BUS\n}\n\ncomponent \&quot;LED模块\&quot; as LED {\n    component \&quot;led(4)\&quot; as LED_PIN\n}\n\ncomponent \&quot;主控模块\&quot; as MAIN {\n    component \&quot;全局变量\\nreceive_msg\&quot; as RECV_MSG\n    component \&quot;初始化流程\&quot; as SETUP\n}\n\ncomponent \&quot;线程管理\&quot; as THREADS {\n    component \&quot;LED指示线程\&quot; as LED_THREAD\n    component \&quot;同步收发线程\&quot; as SYNC_THREAD\n    component \&quot;异步接收线程\&quot; as ASYNC_RECV\n    component \&quot;CAN发送线程\&quot; as SEND_THREAD\n}\n\nMAIN --&gt; THREADS : 启动线程\nSETUP --&gt; CAN_BUS : 初始化配置\nSETUP --&gt; LED_PIN : 引脚配置\n\nASYNC_RECV --&gt; CAN_BUS : 监听数据\nASYNC_RECV --&gt; RECV_MSG : 更新全局变量\\n(异步模式)\n\nSEND_THREAD --&gt; CAN_BUS : 发送数据包\nSEND_THREAD &lt;-- RECV_MSG : 读取数据\\n(异步模式)\n\nSYNC_THREAD --&gt; CAN_BUS : 实时转发数据\\n(同步模式)\n\nLED_THREAD --&gt; LED_PIN : PWM控制\nLED_THREAD &lt;-- CAN_BUS : 检测\\n总线状态\nLED_THREAD &lt;-- MAIN : 获取\\n系统异常\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-840" y="-310" width="902.99" height="444" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass HXC_CAN_message_t {\n  + identifier : uint32_t\n  + data_length_code : uint8_t\n  + data : byte[8]\n  + --\n  + 包含两个float数据项\\n(各占4字节)\n}\n\nnote right\n  标准帧格式定义：\n  - identifier为设备标识\n  - data字段可存储：\n    2个float传感器数据\n    或8字节原始数据\nend note\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="640" y="60" width="422" height="151" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\n:系统上电;\n:执行setup();\n:初始化LED模块\\n(led.setup());\n:配置CAN总线\\n(CAN_BUS.setup());\nif (工作模式选择) then (同步模式)\n  :创建同步收发线程\\n(即时转发);\nelse (异步模式)\n  :创建异步接收线程;\n  :创建数据处理线程;\nendif\nfork\n  :启动LED状态线程;\nfork again\n  :启动CAN接收线程;\nfork again\n  :启动CAN发送线程;\nend fork\n:进入主循环;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-4">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="160" y="-368" width="439" height="660" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstate \&quot;正常模式\&quot; as Normal : 呼吸灯效果\\n低亮度渐变\nstate \&quot;CAN离线\&quot; as CanOutline : 快闪模式\nstate \&quot;设备离线\&quot; as DeviceOutline : 常亮模式\\n(高亮度)\nstate \&quot;其他异常\&quot; as Other : 双闪模式\n\n[*] --&gt; Normal\nNormal --&gt; CanOutline : 检测到\\n总线错误\nNormal --&gt; DeviceOutline : 外设\\n无响应\nNormal --&gt; Other : 未知\\n异常类型\n\nCanOutline --&gt; Normal : 总线\\n恢复\nDeviceOutline --&gt; Normal : 设备\\n重连\nOther --&gt; Normal : 异常\\n解除\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="640" y="-320" width="427" height="303" as="geometry" />
          </mxCell>
        </UserObject>
