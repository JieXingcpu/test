    <mxGraphModel dx="2505" dy="879" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ncomponent \&quot;CAN模块\&quot; as CAN {\n    component \&quot;CAN_BUS(6,7)\&quot; as CAN_BUS\n}\n\ncomponent \&quot;LED模块\&quot; as LED {\n    component \&quot;led(4)\&quot; as LED_PIN\n}\n\ncomponent \&quot;主控模块\&quot; as MAIN {\n    component \&quot;全局变量\\nreceive_msg\&quot; as RECV_MSG\n    component \&quot;初始化流程\&quot; as SETUP\n}\n\ncomponent \&quot;线程管理\&quot; as THREADS {\n    component \&quot;LED指示线程\&quot; as LED_THREAD\n    component \&quot;同步收发线程\&quot; as SYNC_THREAD\n    component \&quot;异步接收线程\&quot; as ASYNC_RECV\n    component \&quot;CAN发送线程\&quot; as SEND_THREAD\n}\n\nMAIN --&gt; THREADS : 启动线程\nSETUP --&gt; CAN_BUS : 初始化配置\nSETUP --&gt; LED_PIN : 引脚配置\n\nASYNC_RECV --&gt; CAN_BUS : 监听数据\nASYNC_RECV --&gt; RECV_MSG : 更新全局变量\\n(异步模式)\n\nSEND_THREAD --&gt; CAN_BUS : 发送数据包\nSEND_THREAD &lt;-- RECV_MSG : 读取数据\\n(异步模式)\n\nSYNC_THREAD --&gt; CAN_BUS : 实时转发数据\\n(同步模式)\n\nLED_THREAD --&gt; LED_PIN : PWM控制\nLED_THREAD &lt;-- CAN_BUS : 检测\\n总线状态\nLED_THREAD &lt;-- MAIN : 获取\\n系统异常\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VmwB85Ww3C7b3GIS1e9m-1">
