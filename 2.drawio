        <mxCell id="W11vk77ngovL1KlK19xO-44" value="&lt;p style=&quot;margin:0px;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;收、发线程（异步模式）&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1.MCU接收数据线程&lt;br&gt;2.CAN消息发送线程&lt;/p&gt;" style="align=left;overflow=fill;html=1;dropTarget=0;whiteSpace=wrap;shadow=1;rounded=0;gradientColor=none;fillColor=#E3E3E3;" parent="dEVE-zZ0Ij1FK5C9I8Qt-19" vertex="1">
